{
    "name": "@focus-ai/desktop",
    "private": true,
    "version": "0.1.0",
    "author": "Focus AI",
    "description": "Focus AI Desktop App",
    "main": "dist-electron/main.js",
    "build": {
        "appId": "com.focusai.app",
        "productName": "Focus AI",
        "electronVersion": "28.1.0",
        "directories": {
            "output": "dist_electron",
            "buildResources": "build"
        },
        "files": [
            "dist/**/*",
            "dist-electron/**/*"
        ],
        "mac": {
            "category": "public.app-category.productivity",
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ],
            "hardenedRuntime": true,
            "gatekeeperAssess": false
        },
        "dmg": {
            "sign": false
        },
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "deleteAppDataOnUninstall": false
        },
        "linux": {
            "target": [
                "AppImage",
                "deb"
            ],
            "category": "Office"
        }
    },
    "scripts": {
        "dev:web": "vite",
        "dev": "ELECTRON=true vite",
        "build:web": "vite build",
        "build": "ELECTRON=true tsc && ELECTRON=true vite build",
        "package": "ELECTRON=true tsc && ELECTRON=true vite build && ELECTRON=true electron-builder",
        "package:mac": "npm run package -- --mac",
        "package:win": "npm run package -- --win",
        "package:linux": "npm run package -- --linux",
        "package:all": "npm run package -- --mac --win --linux",
        "preview": "vite preview"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@react-three/drei": "^9.122.0",
        "@react-three/fiber": "^8.18.0",
        "@reduxjs/toolkit": "^2.11.2",
        "@types/react-big-calendar": "^1.16.3",
        "@types/three": "^0.185.4",
        "date-fns": "^4.1.0",
        "electron-is-dev": "^3.0.1",
        "framer-motion": "^12.23.26",
        "katex": "^0.18.7",
        "lucide-react": "^0.303.0",
        "mermaid": "^12.0.0",
        "react": "^18.2.0",
        "react-big-calendar": "^1.19.4",
        "react-circular-progressbar": "^2.2.0",
        "react-dom": "^18.2.0",
        "react-markdown": "^10.1.0",
        "react-redux": "^9.2.0",
        "recharts": "^3.6.0",
        "rehype-katex": "^7.0.1",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0",
        "three": "^0.185.1"
    },
    "devDependencies": {
        "@tailwindcss/typography": "^0.5.20",
        "@types/react": "^18.2.43",
        "@types/react-dom": "^18.2.17",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.16",
        "electron": "^28.3.3",
        "electron-builder": "^24.9.1",
        "postcss": "^8.4.32",
        "tailwindcss": "^3.4.0",
        "typescript": "^5.3.3",
        "vite": "^5.0.10",
        "vite-plugin-electron": "^0.15.4",
        "vite-plugin-electron-renderer": "^0.14.5"
    }
}
